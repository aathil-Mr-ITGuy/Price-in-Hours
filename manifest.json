{
  "manifest_version": 3,
  "name": "Price in Hours",
  "version": "1.0",
  "description": "Convert e-commerce prices into hours of work based on your salary.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.noon.com/*"],
      "css": ["content/inject.css"],
      "js": ["content/core.js", "content/sites/noon.js"]
    },
    {
      "matches": ["*://*.amazon.ae/*"],
      "css": ["content/inject.css"],
      "js": ["content/core.js", "content/sites/amazon.ae.js"]
    },
    {
      "matches": ["*://*.flipkart.com/*"],
      "css": ["content/inject.css"],
      "js": ["content/core.js", "content/sites/flipkart.js"]
    },
    {
      "matches": ["*://*.amazon.in/*"],
      "css": ["content/inject.css"],
      "js": ["content/core.js", "content/sites/amazon.in.js"]
    },
    {
      "matches": ["*://*.myntra.com/*"],
      "css": ["content/inject.css"],
      "js": ["content/core.js", "content/sites/myntra.js"]
    }
  ]
}
